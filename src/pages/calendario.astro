---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/db';
import { listWorkoutsBetween, type WorkoutListItem } from '../lib/repo';
import { dayKey, gridRange, monthGrid, monthParam, parseMonth, shiftMonth } from '../lib/calendar';
import { formatDuration } from '../lib/rest';

const now = new Date();
const todayKey = dayKey(now);
const ref = parseMonth(Astro.url.searchParams.get('mes'), now);
const weeks = monthGrid(ref);
const gridKeys = new Set(weeks.flat().map((c) => c.key));
const { fromMs, toMs } = gridRange(weeks);

const byDay = new Map<string, WorkoutListItem[]>();
for (const w of listWorkoutsBetween(getDb(), fromMs, toMs)) {
  const key = dayKey(new Date(w.startedAt));
  byDay.set(key, [...(byDay.get(key) ?? []), w]);
}

const isCurrentMonth = ref.year === now.getFullYear() && ref.month === now.getMonth();
const requested = Astro.url.searchParams.get('dia') ?? '';
const selected = gridKeys.has(requested) ? requested : isCurrentMonth ? todayKey : null;

const monthPrefix = monthParam(ref);
const monthWorkouts = [...byDay.entries()]
  .filter(([key]) => key.startsWith(monthPrefix))
  .flatMap(([, list]) => list);
const monthSets = monthWorkouts.reduce((sum, w) => sum + w.setCount, 0);
const monthKg = Math.round(monthWorkouts.reduce((sum, w) => sum + w.volumeKg, 0));

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const toDate = (key: string) => {
  const [y, m, d] = key.split('-').map(Number);
  return new Date(y, m - 1, d);
};
const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const monthLabel = capitalize(
  new Date(ref.year, ref.month, 1).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' }),
);
const fullDate = (key: string) =>
  capitalize(toDate(key).toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' }));
const time = (ms: number) =>
  new Date(ms).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
const href = (key: string) => `/calendario?mes=${key.slice(0, 7)}&dia=${key}`;
const selectedWorkouts = selected ? (byDay.get(selected) ?? []) : [];
---

<Layout title="Calendario · Gym">
  <div class="row">
    <h1>Calendario</h1>
    <a class="btn" href="/calendario">Hoy</a>
  </div>

  <div class="row month">
    <a class="btn" href={`/calendario?mes=${monthParam(shiftMonth(ref, -1))}`} aria-label="Mes anterior">‹</a>
    <strong>{monthLabel}</strong>
    <a class="btn" href={`/calendario?mes=${monthParam(shiftMonth(ref, 1))}`} aria-label="Mes siguiente">›</a>
  </div>

  <p class="muted">
    {
      monthWorkouts.length === 0
        ? 'Sin entrenamientos este mes.'
        : `${plural(monthWorkouts.length, 'entrenamiento', 'entrenamientos')} · ${plural(monthSets, 'serie', 'series')} · ${monthKg} kg`
    }
  </p>

  <div class="grid head">
    {['L', 'M', 'X', 'J', 'V', 'S', 'D'].map((d) => <span>{d}</span>)}
  </div>
  {
    weeks.map((week) => (
      <div class="grid">
        {week.map((cell) => {
          const count = byDay.get(cell.key)?.length ?? 0;
          return (
            <a
              href={href(cell.key)}
              class:list={[
                'cell',
                { out: !cell.inMonth, today: cell.key === todayKey, selected: cell.key === selected },
              ]}
              aria-label={`${fullDate(cell.key)}${count > 0 ? `, ${plural(count, 'entrenamiento', 'entrenamientos')}` : ''}`}
              aria-current={cell.key === todayKey ? 'date' : undefined}
            >
              <span>{cell.day}</span>
              {count > 0 && <span class="dot">{count > 1 ? count : ''}</span>}
            </a>
          );
        })}
      </div>
    ))
  }

  {
    selected && (
      <>
        <h2>{fullDate(selected)}</h2>
        {selectedWorkouts.length === 0 && <p class="muted">Sin entrenamientos este día.</p>}
        <ul class="plain">
          {selectedWorkouts.map((w) => (
            <li class="card">
              <a href={`/workouts/${w.id}`}>{w.routineName ?? 'Rutina eliminada'}</a>
              <div class="muted">
                {time(w.startedAt)} · {plural(w.setCount, 'serie', 'series')} · {Math.round(w.volumeKg)} kg
                {w.endedAt ? ` · ${formatDuration(w.startedAt, w.endedAt)}` : ' · en curso'}
              </div>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Layout>

<style>
  .month { margin-bottom: 0.25rem; }
  .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 4px; }
  .head span { text-align: center; color: var(--muted); font-size: 0.8rem; }
  .cell {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
  }
  .out { opacity: 0.4; }
  .today { border-color: var(--accent); }
  .selected { background: var(--line); }
  .dot {
    min-width: 8px;
    height: 8px;
    border-radius: 8px;
    background: var(--accent);
    color: #07140d;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 8px;
    text-align: center;
  }
  .dot:not(:empty) { height: 14px; line-height: 14px; padding: 0 4px; }
</style>
