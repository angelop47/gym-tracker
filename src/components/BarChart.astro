---
interface Bar {
  label: string;
  value: number;
  /** The period still in progress: drawn as an outline so it is not mistaken for a finished one. */
  current: boolean;
  title: string;
}
interface Props {
  bars: Bar[];
  ariaLabel: string;
}
const { bars, ariaLabel } = Astro.props;

const W = 600;
const H = 230;
const left = 46;
const right = 8;
const top = 14;
const bottom = 30;
const innerW = W - left - right;
const innerH = H - top - bottom;

/** Rounds the top of the axis up to 1, 2, 5 or 10 times a power of ten. */
function niceMax(max: number): number {
  if (max <= 0) return 1;
  const exp = 10 ** Math.floor(Math.log10(max));
  const f = max / exp;
  return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * exp;
}

const axisMax = niceMax(Math.max(0, ...bars.map((b) => b.value)));
const slot = innerW / bars.length;
const barW = slot * 0.62;
const yOf = (v: number) => top + innerH - (v / axisMax) * innerH;
// Thin the labels out when they would overlap, always keeping the latest bar labelled.
const labelEvery = bars.length > 8 ? 2 : 1;
const fmt = (n: number) => Math.round(n).toLocaleString('es-ES');
const ticks = [0, axisMax / 2, axisMax];
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel}>
  {
    ticks.map((t) => (
      <g>
        <line x1={left} x2={W - right} y1={yOf(t)} y2={yOf(t)} class="grid" />
        <text x={left - 6} y={yOf(t) + 4} text-anchor="end" class="axis">{fmt(t)}</text>
      </g>
    ))
  }
  {
    bars.map((b, i) => {
      const x = left + slot * i + (slot - barW) / 2;
      const y = yOf(b.value);
      return (
        <g>
          <title>{b.title}</title>
          <rect x={x} y={y} width={barW} height={Math.max(0, top + innerH - y)} rx="3" class:list={['bar', { current: b.current }]} />
          {(bars.length - 1 - i) % labelEvery === 0 && (
            <text x={x + barW / 2} y={H - 10} text-anchor="middle" class="axis">{b.label}</text>
          )}
        </g>
      );
    })
  }
</svg>

<style>
  svg { width: 100%; height: auto; display: block; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .axis { fill: var(--muted); font-size: 13px; }
  .bar { fill: var(--accent); }
  .bar.current { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 4 3; }
</style>
